{% extends 'base.html.twig' %}

{% block title %}Weather Forecast{% endblock %}

{% block body %}
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: center;
        }
        th {
            background-color: #efefef;
        }
    </style>

    <h1>Weather Forecast</h1>

    {# ---- Formularz ---- #}
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button class="btn">Submit</button>
    {{ form_end(form) }}

    {# ---- Wyniki API ---- #}
    {% if weather_data %}
        <h2>Data from Open-Meteo</h2>

        <table>
            <thead>
            <tr>
                <th>Date</th>
                <th>Max Temperature (°C)</th>
                <th>Min Temperature (°C)</th>
                <th>Precipitation (mm)</th>
            </tr>
            </thead>

            <tbody>
            {% for i in 0..weather_data.daily.time|length - 1 %}
                <tr>
                    <td>{{ weather_data.daily.time[i] }}</td>
                    <td>{{ weather_data.daily.temperature_2m_max[i] }}</td>
                    <td>{{ weather_data.daily.temperature_2m_min[i] }}</td>
                    <td>{{ weather_data.daily.precipitation_sum[i] }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
